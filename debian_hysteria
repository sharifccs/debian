    clear
    noon_log "Installing dependencies for supported OS"
    export DEBIAN_FRONTEND=noninteractive
    noon_apt_update || return 1
    noon_install_packages \
        curl wget cron sudo ca-certificates gnupg lsb-release \
        python3 python3-minimal python3-pip \
        iptables iptables-persistent netfilter-persistent iproute2 \
        netcat-openbsd httpie php php-cli php-curl php-mysql \
        vnstat screen squid stunnel4 dropbear gnutls-bin \
        dos2unix nano unzip jq virt-what net-tools default-mysql-client \
        plocate dh-make libaudit-dev build-essential fail2ban \
        lsof tar git socat dnsutils dbus systemd || return 1
    systemctl enable --now cron >/dev/null 2>&1 || true
    mkdir -p /usr/local/bin /usr/local/var/run /root/.web
    chmod 777 /root/.web 2>/dev/null || true
    touch /var/spool/cron/crontabs/root 2>/dev/null || true
    chmod 600 /var/spool/cron/crontabs/root 2>/dev/null || true
    command -v virt-what >/dev/null 2>&1 && virt-what >/root/virt_type.txt 2>/dev/null || true
    noon_log "Dependencies installed"
}

