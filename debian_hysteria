#!/usr/bin/env bash
# ============================================================================
# NoonDev 2026 compatibility layer
# Supported: Debian 12/13; Ubuntu 22.04/24.04/26.04 LTS (amd64)
# Keeps the original developer service/port flow, but repairs modern OS issues.
# ============================================================================
NOONDEV_BASE_URL="https://noonvipvpn.xyz/github/noondev-main"
NOONDEV_LOG="/var/log/noondev-installer.log"
mkdir -p /var/log
: >"$NOONDEV_LOG" 2>/dev/null || true
chmod 600 "$NOONDEV_LOG" 2>/dev/null || true

noon_log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$NOONDEV_LOG"
}

noon_wait_apt() {
    local i
    for i in $(seq 1 120); do
        if ! fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done
    noon_log "ERROR: apt/dpkg lock did not clear within 240 seconds"
    return 1
}

noon_dns_ok() {
    getent ahostsv4 deb.debian.org >/dev/null 2>&1 || getent ahostsv4 archive.ubuntu.com >/dev/null 2>&1
}

noon_fix_dns() {
    noon_dns_ok && return 0
    noon_log "DNS lookup failed; applying a safe resolver fallback"
    if systemctl list-unit-files systemd-resolved.service >/dev/null 2>&1; then
        mkdir -p /etc/systemd/resolved.conf.d
        cat >/etc/systemd/resolved.conf.d/99-noondev.conf <<'EOF'
[Resolve]
DNS=1.1.1.1 8.8.8.8
FallbackDNS=9.9.9.9
EOF
        systemctl enable --now systemd-resolved >/dev/null 2>&1 || true
        systemctl restart systemd-resolved >/dev/null 2>&1 || true
        if [ -e /run/systemd/resolve/resolv.conf ]; then
            ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf 2>/dev/null || true
        fi
    elif [ ! -L /etc/resolv.conf ]; then
        cp -a /etc/resolv.conf /etc/resolv.conf.noondev-backup 2>/dev/null || true
        cat >/etc/resolv.conf <<'EOF'
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF
    fi
    noon_dns_ok
}

noon_repair_sources() {
    . /etc/os-release
    local stamp backup codename
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="/root/noondev-apt-backup-$stamp"
    mkdir -p "$backup/sources.list.d"
    cp -a /etc/apt/sources.list "$backup/" 2>/dev/null || true
    cp -a /etc/apt/sources.list.d/. "$backup/sources.list.d/" 2>/dev/null || true

    find /etc/apt/sources.list.d -maxdepth 1 -type f \( -name '*.list' -o -name '*.sources' \) \
        -exec mv -f {} "$backup/sources.list.d/" \; 2>/dev/null || true

    codename="${VERSION_CODENAME:-}"
    if [ "$ID" = "debian" ]; then
        case "$VERSION_ID" in
            12*) codename=bookworm ;;
            13*) codename=trixie ;;
            *) noon_log "ERROR: unsupported Debian $VERSION_ID"; return 1 ;;
        esac
        cat >/etc/apt/sources.list <<EOF
deb http://deb.debian.org/debian $codename main contrib non-free non-free-firmware
deb http://deb.debian.org/debian $codename-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security $codename-security main contrib non-free non-free-firmware
EOF
    elif [ "$ID" = "ubuntu" ]; then
        case "$VERSION_ID" in
            22.04|24.04|26.04) ;;
            *) noon_log "ERROR: unsupported Ubuntu $VERSION_ID"; return 1 ;;
        esac
        [ -n "$codename" ] || { noon_log "ERROR: Ubuntu codename missing"; return 1; }
        cat >/etc/apt/sources.list <<EOF
deb http://archive.ubuntu.com/ubuntu $codename main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu $codename-updates main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu $codename-backports main restricted universe multiverse
deb http://security.ubuntu.com/ubuntu $codename-security main restricted universe multiverse
EOF
    else
        noon_log "ERROR: unsupported distro $ID"
        return 1
    fi
}

noon_apt_update() {
    noon_wait_apt || return 1
    if apt-get -o Acquire::Retries=4 update; then
        return 0
    fi
    noon_log "apt update failed; repairing official OS repositories"
    noon_repair_sources || return 1
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    mkdir -p /var/lib/apt/lists/partial
    apt-get -o Acquire::Retries=4 update
}

noon_pkg_alias() {
    case "$1" in
        python3-minimal) echo python3-minimal ;;
        libpython3-stdlib) echo libpython3-stdlib ;;
        python) echo python3 ;;
        netcat-openbsd) echo netcat-openbsd ;;
        plocate) echo plocate ;;
        squid3|squid3-common) echo squid ;;
        gnupg1) echo gnupg ;;
        *) echo "$1" ;;
    esac
}

noon_install_packages() {
    local pkg mapped
    local -a list=()
    for pkg in "$@"; do
        mapped="$(noon_pkg_alias "$pkg")"
        if apt-cache show "$mapped" >/dev/null 2>&1; then
            if [[ ! " ${list[*]} " =~ " ${mapped} " ]]; then
                list+=("$mapped")
            fi
        else
            noon_log "WARN: package not available on this OS: $pkg"
        fi
    done
    [ "${#list[@]}" -eq 0 ] && return 0
    noon_wait_apt || return 1
    DEBIAN_FRONTEND=noninteractive apt-get -y -o Acquire::Retries=4 --no-install-recommends install "${list[@]}"
}

noon_backup_sources() {
    mkdir -p /etc/apt/sources.list.d
    touch /etc/apt/sources.list
    cp -f /etc/apt/sources.list /etc/apt/sources.list_backup
}

noon_restore_sources() {
    if [ -f /etc/apt/sources.list_backup ]; then
        cp -f /etc/apt/sources.list_backup /etc/apt/sources.list
    fi
}

noon_public_ip() {
    curl -4 -fsS --max-time 12 https://api.ipify.org 2>/dev/null \
        || curl -4 -fsS --max-time 12 https://ipinfo.io/ip 2>/dev/null \
        || true
}

noon_interface() {
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'
}

noon_configure_dns() {
    if systemctl list-unit-files systemd-resolved.service >/dev/null 2>&1; then
        mkdir -p /etc/systemd/resolved.conf.d
        cat >/etc/systemd/resolved.conf.d/99-noondev.conf <<'EOF'
[Resolve]
DNS=1.1.1.1 8.8.8.8
FallbackDNS=9.9.9.9
EOF
        systemctl restart systemd-resolved >/dev/null 2>&1 || true
    fi
}

noon_network_tune() {
    local iface
    iface="$(noon_interface)"
    modprobe tcp_bbr >/dev/null 2>&1 || true
    mkdir -p /etc/sysctl.d /etc/security/limits.d
    cat >/etc/sysctl.d/99-noondev-vpn-performance.conf <<'EOF'
net.ipv4.ip_forward=1
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.core.rmem_max=67108864
net.core.wmem_max=67108864
net.core.rmem_default=262144
net.core.wmem_default=262144
net.core.netdev_max_backlog=32768
net.core.somaxconn=8192
net.ipv4.udp_rmem_min=16384
net.ipv4.udp_wmem_min=16384
net.ipv4.tcp_rmem=4096 87380 33554432
net.ipv4.tcp_wmem=4096 65536 33554432
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.default.rp_filter=0
EOF
    [ -n "$iface" ] && printf 'net.ipv4.conf.%s.rp_filter=0\n' "$iface" >>/etc/sysctl.d/99-noondev-vpn-performance.conf
    cat >/etc/security/limits.d/99-noondev.conf <<'EOF'
* soft nofile 65535
* hard nofile 65535
root soft nofile 65535
root hard nofile 65535
EOF
    sysctl --system >/dev/null 2>&1 || true
}

noon_apply_ovpn_nat() {
    local iface net
    iface="$(noon_interface)"
    [ -n "$iface" ] || { noon_log "ERROR: cannot detect network interface for NAT"; return 1; }
    for net in 10.10.0.0/16 10.20.0.0/16 10.30.0.0/22; do
        iptables -t nat -C POSTROUTING -s "$net" -o "$iface" -j MASQUERADE 2>/dev/null \
            || iptables -t nat -A POSTROUTING -s "$net" -o "$iface" -j MASQUERADE
    done
    mkdir -p /etc/iptables
    iptables-save >/etc/iptables_rules.v4 2>/dev/null || true
    ip6tables-save >/etc/iptables_rules.v6 2>/dev/null || true
    iptables-save >/etc/iptables/rules.v4 2>/dev/null || true
    ip6tables-save >/etc/iptables/rules.v6 2>/dev/null || true
    command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1 || true
    noon_log "OpenVPN NAT ready on $iface for UDP/TCP pools"
}

noon_preflight() {
    local expected="$1" arch
    [ "$(id -u)" -eq 0 ] || { echo "Run as root"; return 1; }
    [ -r /etc/os-release ] || { echo "Cannot detect OS"; return 1; }
    . /etc/os-release
    arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
    case "$arch" in amd64|x86_64) ;; *) echo "Unsupported architecture: $arch (current bundled binaries are amd64)"; return 1;; esac
    if [ "$expected" = "debian" ]; then
        [ "$ID" = "debian" ] || { echo "This installer is for Debian"; return 1; }
        case "$VERSION_ID" in 12*|13*) ;; *) echo "Supported Debian: 12, 13. Detected: $VERSION_ID"; return 1;; esac
    else
        [ "$ID" = "ubuntu" ] || { echo "This installer is for Ubuntu"; return 1; }
        case "$VERSION_ID" in 22.04|24.04|26.04) ;; *) echo "Supported Ubuntu: 22.04, 24.04, 26.04 LTS. Detected: $VERSION_ID"; return 1;; esac
    fi
    export DEBIAN_FRONTEND=noninteractive
    export NEEDRESTART_MODE=a
    noon_log "Preflight: $PRETTY_NAME / arch=$arch"
    noon_fix_dns || { noon_log "ERROR: DNS resolution is not working"; return 1; }
    noon_apt_update || return 1
    noon_install_packages sudo ca-certificates curl wget gnupg cron python3 python3-minimal iproute2 procps || return 1
    noon_backup_sources
    noon_configure_dns
    noon_network_tune
    noon_log "Preflight complete"
}

noon_stage() {
    local name="$1"; shift
    noon_log "START: $name"
    "$@"
    local rc=$?
    if [ "$rc" -ne 0 ]; then
        noon_log "ERROR: $name failed with rc=$rc"
        return "$rc"
    fi
    noon_log "DONE: $name"
}

timedatectl set-timezone Asia/Riyadh

